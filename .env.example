# ---- Firebase (live orders + admin edits sab devices par chalne ke liye) ----
# README.md me step-by-step likha hai. Agar ye khali chhor dein to site "demo mode" me chalegi
# (data sirf usi browser me save hoga).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Demo mode me admin password (Firebase ho to ye use nahi hota)
VITE_ADMIN_PASSWORD=admin123

# Optional: CallMeBot se admin ko WhatsApp par auto message (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
VITE_CALLMEBOT_PHONE=
VITE_CALLMEBOT_APIKEY=
